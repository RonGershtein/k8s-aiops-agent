# LLM: "anthropic" or "gemini" for a real model, "scripted" for the offline fake used in tests and CI
AGENT_LLM_PROVIDER=scripted
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_JUDGE_MODEL=claude-opus-5-5
AGENT_EFFORT=medium
# Gemini (free tier in Google AI Studio) also judges the evals when it is the provider
GEMINI_API_KEY=
AGENT_GEMINI_MODEL=gemini-3.5-flash-lite
# AGENT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Kubernetes access: "live" talks to the cluster, "fixture" replays recorded snapshots
AGENT_BACKEND=fixture
AGENT_KUBECONFIG=.kube/agent-readonly.kubeconfig
# Only used with --allow-remediation; may patch Service selectors in scenario-03 only (RBAC)
AGENT_REMEDIATOR_KUBECONFIG=.kube/agent-remediator.kubeconfig
AGENT_ALLOWED_NAMESPACES=["scenario-00","scenario-01","scenario-02","scenario-03","scenario-04","scenario-05"]

# Stopping conditions
AGENT_MAX_STEPS=12
AGENT_MAX_TOTAL_TOKENS=60000
AGENT_TIMEOUT_SECONDS=120

# Observability (Langfuse over OpenTelemetry); leave empty to trace to local JSONL only
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
